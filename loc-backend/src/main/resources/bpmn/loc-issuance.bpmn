<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_LocIssuance"
                  targetNamespace="http://tradefinance.example/loc"
                  exporter="Camunda Modeler"
                  exporterVersion="5.49.0"
                  modeler:executionPlatform="Camunda Cloud"
                  modeler:executionPlatformVersion="8.8.0">

  <bpmn:error id="Error_SanctionsHit" name="Sanctions hit" errorCode="SANCTIONS_HIT" />
  <bpmn:error id="Error_DocumentDiscrepancy" name="Document discrepancy" errorCode="DOCUMENT_DISCREPANCY" />

  <bpmn:process id="loc-issuance" name="Letter of Credit Issuance" isExecutable="true">
    <bpmn:documentation>Educational trade finance workflow inspired by Commerzbank's Letter of Credit services. Not connected to any real banking system; external checks are mocked.</bpmn:documentation>

    <!-- ===================== Start & validation ===================== -->
    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="LoC application received">
      <bpmn:outgoing>Flow_ToMergeValidation</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="Gateway_MergeValidation">
      <bpmn:incoming>Flow_ToMergeValidation</bpmn:incoming>
      <bpmn:incoming>Flow_CorrectionDone</bpmn:incoming>
      <bpmn:outgoing>Flow_ToValidate</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_ValidateApplication" name="Validate application details">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-application" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToValidate</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayValid</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_ApplicationValid" name="Application valid?">
      <bpmn:incoming>Flow_ToGatewayValid</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_ValidNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_CorrectApplication" name="Correct application">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="trade-operations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidNo</bpmn:incoming>
      <bpmn:incoming>Flow_DocumentDiscrepancy</bpmn:incoming>
      <bpmn:outgoing>Flow_CorrectionDone</bpmn:outgoing>
    </bpmn:userTask>

    <!-- TIMER boundary (interrupting): correction not done in time -> reject -->
    <bpmn:boundaryEvent id="Boundary_CorrectionTimeout" name="Correction deadline passed" attachedToRef="Task_CorrectApplication">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;Application was not corrected within the allowed time&quot;" target="rejectionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CorrectionTimedOut</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_CorrectionTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=if correctionTimeout != null then correctionTimeout else "PT48H"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- ===================== Eligibility ===================== -->
    <bpmn:serviceTask id="Task_CheckEligibility" name="Check customer eligibility">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-customer-eligibility" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayEligible</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CustomerEligible" name="Customer eligible?">
      <bpmn:incoming>Flow_ToGatewayEligible</bpmn:incoming>
      <bpmn:outgoing>Flow_EligibleYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_EligibleNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ===================== Compliance: CALL ACTIVITY ===================== -->
    <bpmn:callActivity id="CallActivity_ComplianceScreening" name="Perform compliance screening (sanctions + AML)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="loc-compliance-screening" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=[{name: applicantName, country: applicantCountry, role: &quot;APPLICANT&quot;}, {name: beneficiaryName, country: beneficiaryCountry, role: &quot;BENEFICIARY&quot;}, {name: beneficiaryBankName, country: beneficiaryCountry, role: &quot;ADVISING_BANK&quot;}]" target="parties" />
          <zeebe:output source="=complianceStatus" target="complianceStatus" />
          <zeebe:output source="=sanctionsResults" target="sanctionsResults" />
          <zeebe:output source="=amlRiskScore" target="amlRiskScore" />
          <zeebe:output source="=rejectionReason" target="rejectionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EligibleYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayCompliance</bpmn:outgoing>
    </bpmn:callActivity>

    <!-- ERROR boundary: thrown by the called process when a party is on a sanctions list -->
    <bpmn:boundaryEvent id="Boundary_SanctionsHit" name="Sanctions hit" attachedToRef="CallActivity_ComplianceScreening">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;Sanctions screening found a match for one of the trade parties&quot;" target="rejectionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_SanctionsHit</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_SanctionsHitCatch" errorRef="Error_SanctionsHit" />
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gateway_ComplianceResult" name="Compliance clear?">
      <bpmn:incoming>Flow_ToGatewayCompliance</bpmn:incoming>
      <bpmn:outgoing>Flow_ComplianceClear</bpmn:outgoing>
      <bpmn:outgoing>Flow_ComplianceRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ===================== Documents: EMBEDDED SUBPROCESS ===================== -->
    <bpmn:subProcess id="SubProcess_VerifyDocuments" name="Verify trade documents">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=documentResults" target="documentResults" />
          <zeebe:output source="=every result in documentResults satisfies result.valid = true" target="documentsVerified" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ComplianceClear</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCreditAssessment</bpmn:outgoing>

      <bpmn:startEvent id="StartEvent_Documents" name="Documents received">
        <bpmn:outgoing>Flow_ToVerifyDocument</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- SEQUENTIAL multi-instance: one document after the other -->
      <bpmn:serviceTask id="Task_VerifyDocument" name="Verify trade document">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="verify-trade-document" retries="3" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_ToVerifyDocument</bpmn:incoming>
        <bpmn:outgoing>Flow_ToGatewayDocuments</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=tradeDocuments" inputElement="document" outputCollection="documentResults" outputElement="=documentResult" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>

      <bpmn:exclusiveGateway id="Gateway_DocumentsValid" name="All documents valid?">
        <bpmn:incoming>Flow_ToGatewayDocuments</bpmn:incoming>
        <bpmn:outgoing>Flow_DocumentsOk</bpmn:outgoing>
        <bpmn:outgoing>Flow_DocumentsNotOk</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:endEvent id="EndEvent_DocumentsVerified" name="Documents verified">
        <bpmn:incoming>Flow_DocumentsOk</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:endEvent id="End_DocumentDiscrepancy" name="Discrepancy found">
        <bpmn:incoming>Flow_DocumentsNotOk</bpmn:incoming>
        <bpmn:errorEventDefinition id="ErrorDef_DocumentDiscrepancyThrow" errorRef="Error_DocumentDiscrepancy" />
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_ToVerifyDocument" sourceRef="StartEvent_Documents" targetRef="Task_VerifyDocument" />
      <bpmn:sequenceFlow id="Flow_ToGatewayDocuments" sourceRef="Task_VerifyDocument" targetRef="Gateway_DocumentsValid" />
      <bpmn:sequenceFlow id="Flow_DocumentsOk" name="Yes" sourceRef="Gateway_DocumentsValid" targetRef="EndEvent_DocumentsVerified">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=every result in documentResults satisfies result.valid = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_DocumentsNotOk" name="No" sourceRef="Gateway_DocumentsValid" targetRef="End_DocumentDiscrepancy">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some result in documentResults satisfies result.valid = false</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:subProcess>

    <!-- ERROR boundary on the subprocess: discrepancy -> back to correction -->
    <bpmn:boundaryEvent id="Boundary_DocumentDiscrepancy" name="Document discrepancy" attachedToRef="SubProcess_VerifyDocuments">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&quot;One or more trade documents have discrepancies&quot;" target="correctionReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_DocumentDiscrepancy</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_DocumentDiscrepancyCatch" errorRef="Error_DocumentDiscrepancy" />
    </bpmn:boundaryEvent>

    <!-- ===================== Credit: REST CONNECTOR ===================== -->
    <bpmn:serviceTask id="Task_CreditAssessment" name="Perform credit assessment" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="12">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="http://localhost:8081/api/mock/credit-bureau/assessments" target="url" />
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers" />
          <zeebe:input source="false" target="storeResponse" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={applicationId: applicationId, customerId: customerId, amount: amount, currency: currency, customerRiskRating: customerRiskRating}" target="body" />
          <zeebe:input source="false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="12" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={creditScore: response.body.creditScore, riskLevel: response.body.riskLevel, creditApproved: response.body.creditApproved, rejectionReason: if response.body.creditApproved then null else &quot;Credit assessment declined (risk level &quot; + response.body.riskLevel + &quot;)&quot;}" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToCreditAssessment</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayCredit</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_CreditDecision" name="Credit approved?">
      <bpmn:incoming>Flow_ToGatewayCredit</bpmn:incoming>
      <bpmn:outgoing>Flow_CreditYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_CreditNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ===================== Approval + TIMER escalation ===================== -->
    <bpmn:userTask id="Task_ManagerApproval" name="Obtain manager approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="credit-managers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreditYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToMergeApproval</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="Boundary_ApprovalTimeout" name="Approval overdue" attachedToRef="Task_ManagerApproval">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=true" target="approvalEscalated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToEscalatedApproval</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_ApprovalTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=if approvalTimeout != null then approvalTimeout else "PT24H"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="Task_EscalatedApproval" name="Escalated approval (senior manager)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="senior-managers" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToEscalatedApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_EscalatedToMerge</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_MergeApproval">
      <bpmn:incoming>Flow_ToMergeApproval</bpmn:incoming>
      <bpmn:incoming>Flow_EscalatedToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayApproval</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gateway_ApprovalDecision" name="Manager decision?">
      <bpmn:incoming>Flow_ToGatewayApproval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_ApprovalRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- ===================== Draft, terms, issuance ===================== -->
    <bpmn:exclusiveGateway id="Gateway_MergeDraft">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_TermsNo</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGenerateDraft</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_GenerateDraft" name="Generate LoC draft">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-loc-draft" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToGenerateDraft</bpmn:incoming>
      <bpmn:outgoing>Flow_ToVerifyTerms</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="Task_VerifyTerms" name="Verify LoC terms">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="trade-operations" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToVerifyTerms</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGatewayTerms</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_TermsVerified" name="Terms correct?">
      <bpmn:incoming>Flow_ToGatewayTerms</bpmn:incoming>
      <bpmn:outgoing>Flow_TermsYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_TermsNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_IssueLoC" name="Issue Letter of Credit">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="issue-loc" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TermsYes</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyCustomer</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- EMAIL CONNECTOR: success notification -->
    <bpmn:serviceTask id="Task_NotifyCustomer" name="Notify customer" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="loc-workflow" target="authentication.username" />
          <zeebe:input source="mailpit" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="localhost" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="1025" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="trade-finance@loc-demo.local" target="data.smtpAction.from" />
          <zeebe:input source="=applicantEmail" target="data.smtpAction.to" />
          <zeebe:input source="=&quot;Your Letter of Credit &quot; + locNumber + &quot; has been issued&quot;" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&quot;Dear &quot; + applicantName + &quot;,\n\nYour Letter of Credit &quot; + locNumber + &quot; for &quot; + string(amount) + &quot; &quot; + currency + &quot; in favour of &quot; + beneficiaryName + &quot; was issued on &quot; + issueDate + &quot;.\n\nKind regards,\nTrade Finance Operations (demo system)&quot;" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndIssued</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_LoCIssued" name="LoC issued">
      <bpmn:incoming>Flow_ToEndIssued</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Rejection path ===================== -->
    <bpmn:exclusiveGateway id="Gateway_MergeRejection">
      <bpmn:incoming>Flow_EligibleNo</bpmn:incoming>
      <bpmn:incoming>Flow_ComplianceRejected</bpmn:incoming>
      <bpmn:incoming>Flow_CreditNo</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalRejected</bpmn:incoming>
      <bpmn:incoming>Flow_SanctionsHit</bpmn:incoming>
      <bpmn:incoming>Flow_CorrectionTimedOut</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRecordRejection</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_RecordRejection" name="Record rejection">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-rejection" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToRecordRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_ToNotifyRejection</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- EMAIL CONNECTOR: rejection notification -->
    <bpmn:serviceTask id="Task_NotifyRejection" name="Notify customer of rejection" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="3">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="loc-workflow" target="authentication.username" />
          <zeebe:input source="mailpit" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="localhost" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="1025" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="NONE" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="trade-finance@loc-demo.local" target="data.smtpAction.from" />
          <zeebe:input source="=applicantEmail" target="data.smtpAction.to" />
          <zeebe:input source="=&quot;Your Letter of Credit application &quot; + applicationId + &quot; was not approved&quot;" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=&quot;Dear &quot; + applicantName + &quot;,\n\nWe are unable to issue a Letter of Credit for application &quot; + applicationId + &quot;.\nReason: &quot; + (if rejectionReason != null then rejectionReason else &quot;not specified&quot;) + &quot;\n\nKind regards,\nTrade Finance Operations (demo system)&quot;" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT10S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToNotifyRejection</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndRejected</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_LoCRejected" name="LoC application rejected">
      <bpmn:incoming>Flow_ToEndRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- ===================== Sequence flows ===================== -->
    <bpmn:sequenceFlow id="Flow_ToMergeValidation" sourceRef="StartEvent_ApplicationReceived" targetRef="Gateway_MergeValidation" />
    <bpmn:sequenceFlow id="Flow_ToValidate" sourceRef="Gateway_MergeValidation" targetRef="Task_ValidateApplication" />
    <bpmn:sequenceFlow id="Flow_ToGatewayValid" sourceRef="Task_ValidateApplication" targetRef="Gateway_ApplicationValid" />
    <bpmn:sequenceFlow id="Flow_ValidYes" name="Yes" sourceRef="Gateway_ApplicationValid" targetRef="Task_CheckEligibility">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=applicationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ValidNo" name="No" sourceRef="Gateway_ApplicationValid" targetRef="Task_CorrectApplication">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=applicationValid = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CorrectionDone" sourceRef="Task_CorrectApplication" targetRef="Gateway_MergeValidation" />
    <bpmn:sequenceFlow id="Flow_CorrectionTimedOut" sourceRef="Boundary_CorrectionTimeout" targetRef="Gateway_MergeRejection" />

    <bpmn:sequenceFlow id="Flow_ToGatewayEligible" sourceRef="Task_CheckEligibility" targetRef="Gateway_CustomerEligible" />
    <bpmn:sequenceFlow id="Flow_EligibleYes" name="Yes" sourceRef="Gateway_CustomerEligible" targetRef="CallActivity_ComplianceScreening">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=customerEligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_EligibleNo" name="No" sourceRef="Gateway_CustomerEligible" targetRef="Gateway_MergeRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=customerEligible = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToGatewayCompliance" sourceRef="CallActivity_ComplianceScreening" targetRef="Gateway_ComplianceResult" />
    <bpmn:sequenceFlow id="Flow_SanctionsHit" sourceRef="Boundary_SanctionsHit" targetRef="Gateway_MergeRejection" />
    <bpmn:sequenceFlow id="Flow_ComplianceClear" name="Clear" sourceRef="Gateway_ComplianceResult" targetRef="SubProcess_VerifyDocuments">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complianceStatus = "CLEAR"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ComplianceRejected" name="Not clear" sourceRef="Gateway_ComplianceResult" targetRef="Gateway_MergeRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=complianceStatus != "CLEAR"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_DocumentDiscrepancy" sourceRef="Boundary_DocumentDiscrepancy" targetRef="Task_CorrectApplication" />
    <bpmn:sequenceFlow id="Flow_ToCreditAssessment" sourceRef="SubProcess_VerifyDocuments" targetRef="Task_CreditAssessment" />
    <bpmn:sequenceFlow id="Flow_ToGatewayCredit" sourceRef="Task_CreditAssessment" targetRef="Gateway_CreditDecision" />
    <bpmn:sequenceFlow id="Flow_CreditYes" name="Yes" sourceRef="Gateway_CreditDecision" targetRef="Task_ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CreditNo" name="No" sourceRef="Gateway_CreditDecision" targetRef="Gateway_MergeRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToMergeApproval" sourceRef="Task_ManagerApproval" targetRef="Gateway_MergeApproval" />
    <bpmn:sequenceFlow id="Flow_ToEscalatedApproval" sourceRef="Boundary_ApprovalTimeout" targetRef="Task_EscalatedApproval" />
    <bpmn:sequenceFlow id="Flow_EscalatedToMerge" sourceRef="Task_EscalatedApproval" targetRef="Gateway_MergeApproval" />
    <bpmn:sequenceFlow id="Flow_ToGatewayApproval" sourceRef="Gateway_MergeApproval" targetRef="Gateway_ApprovalDecision" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Approved" sourceRef="Gateway_ApprovalDecision" targetRef="Gateway_MergeDraft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalRejected" name="Rejected" sourceRef="Gateway_ApprovalDecision" targetRef="Gateway_MergeRejection">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToGenerateDraft" sourceRef="Gateway_MergeDraft" targetRef="Task_GenerateDraft" />
    <bpmn:sequenceFlow id="Flow_ToVerifyTerms" sourceRef="Task_GenerateDraft" targetRef="Task_VerifyTerms" />
    <bpmn:sequenceFlow id="Flow_ToGatewayTerms" sourceRef="Task_VerifyTerms" targetRef="Gateway_TermsVerified" />
    <bpmn:sequenceFlow id="Flow_TermsYes" name="Yes" sourceRef="Gateway_TermsVerified" targetRef="Task_IssueLoC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=termsVerified = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TermsNo" name="No – regenerate draft" sourceRef="Gateway_TermsVerified" targetRef="Gateway_MergeDraft">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=termsVerified = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_ToNotifyCustomer" sourceRef="Task_IssueLoC" targetRef="Task_NotifyCustomer" />
    <bpmn:sequenceFlow id="Flow_ToEndIssued" sourceRef="Task_NotifyCustomer" targetRef="End_LoCIssued" />

    <bpmn:sequenceFlow id="Flow_ToRecordRejection" sourceRef="Gateway_MergeRejection" targetRef="Task_RecordRejection" />
    <bpmn:sequenceFlow id="Flow_ToNotifyRejection" sourceRef="Task_RecordRejection" targetRef="Task_NotifyRejection" />
    <bpmn:sequenceFlow id="Flow_ToEndRejected" sourceRef="Task_NotifyRejection" targetRef="End_LoCRejected" />
  </bpmn:process>

